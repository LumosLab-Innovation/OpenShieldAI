# CLIProxyAPI client configuration only. This file is not loaded automatically.
# No direct OpenAI API key is used or inherited by this adapter.
SHIELD_LLM_PROVIDER=cliproxyapi
SHIELD_LLM_BASE_URL=http://127.0.0.1:8317/v1
SHIELD_LLM_MODEL=operator-selected-codex-alias
SHIELD_LLM_ALLOW_LOOPBACK_HTTP=true
SHIELD_LLM_API_KEY_ENV=SHIELD_CLIPROXY_API_KEY
SHIELD_CLIPROXY_API_KEY=replace-with-your-local-proxy-client-key
SHIELD_LLM_GLOBAL_TOKEN_LIMIT=64000
